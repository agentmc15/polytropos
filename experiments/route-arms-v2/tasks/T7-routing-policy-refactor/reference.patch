+def _candidate_filter_reason(entry, floor, request, rules, excludes, explicit_effort, budget):
+    """The first hard-filter reason for one catalog row, or None when eligible."""
+    if not entry["routable"]:
+        return "not-routable"
+    if entry["availability"] == "unavailable":
+        return "unavailable"
+    if floor["pinned"] and entry["id"] != floor["pinned"]:
+        return "pinned-elsewhere"
+    if entry["id"] in excludes:
+        return "excluded"
+    if entry["reserved"] and not rules["reserved_model_implements"] \
+            and request.get("role", "implementer") == "implementer":
+        return "reserved"
+    if explicit_effort and entry["efforts"] is not None \
+            and explicit_effort not in entry["efforts"]:
+        return "effort-unsupported"
+    if entry["rank"] < floor["rank"]:
+        return "below-floor"
+    if budget is not None and not budget.get("ok", True):
+        return "over-budget"
+    return None
+
