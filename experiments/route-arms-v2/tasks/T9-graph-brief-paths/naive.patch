+# --------------------------------------------------------------------------- path search
+
+def _bounded_int(label, minimum):
+    def parse(value):
+        try:
+            parsed = int(value)
+        except ValueError as exc:
+            raise argparse.ArgumentTypeError(f"must be a {label} integer") from exc
+        if parsed < minimum:
+            raise argparse.ArgumentTypeError(f"must be a {label} integer")
+        return parsed
+    return parse
+
+
+def _pid(node):
+    node_id = node.get("id")
+    return None if node_id is None else str(node_id)
+
+
+def _lookup_node(nodes, query):
+    for node in nodes:
+        if _pid(node) == query:
+            return node, None
+    for node in nodes:
+        if _pid(node) is not None and node.get("label") == query:
+            return node, None
+    message = f"node not found for query {query!r} (lookup checks exact id first, then exact label)"
+    return None, {"error": "node-not-found", "message": message, "query": query}
+
+
+def _one_path(nodes, links, start_id, end_id):
+    if start_id == end_id:
+        return [start_id]
+    known = {_pid(node) for node in nodes if _pid(node) is not None}
+    adjacency = {node_id: [] for node_id in known}
+    for link in links:
+        source, target = link.get("source"), link.get("target")
+        if source is None or target is None:
+            continue
+        source_id, target_id = str(source), str(target)
+        if source_id in known and target_id in known:
+            adjacency[source_id].append(target_id)
+            adjacency[target_id].append(source_id)
+    queue = deque([(start_id, [start_id])])
+    seen = {start_id}
+    while queue:
+        node_id, path = queue.popleft()
+        for neighbor in adjacency.get(node_id, []):
+            if neighbor in seen:
+                continue
+            new_path = path + [neighbor]
+            if neighbor == end_id:
+                return new_path
+            seen.add(neighbor)
+            queue.append((neighbor, new_path))
+    return None
 
+
+def _paths_payload(nodes, links, start_node, end_node, direction, max_hops, max_paths):
+    start_id, end_id = _pid(start_node), _pid(end_node)
+    path = _one_path(nodes, links, start_id, end_id)
+    if path is None:
+        message = f"no path from {start_id} to {end_id} within {max_hops} hops (direction={direction})"
+        return None, {"direction": direction, "end": end_id, "error": "no-path",
+                      "max_hops": max_hops, "message": message, "start": start_id}
+    return {"direction": direction, "end": {"id": end_id, "label": end_node.get("label") or end_id},
+            "hops": len(path) - 1, "max_hops": max_hops, "path_count": 1,
+            "paths": [path], "shown_path_count": 1,
+            "start": {"id": start_id, "label": start_node.get("label") or start_id},
+            "truncated": False}, None
+
+
+def _render_paths(payload):
+    lines = [f"shortest paths from {payload['start']['id']} to {payload['end']['id']} "
+             f"(hops={payload['hops']}, count={payload['path_count']}, direction={payload['direction']}):"]
+    lines.extend(f"  {i}. {' -> '.join(path)}" for i, path in enumerate(payload["paths"], 1))
     return "\n".join(lines)
 
 
