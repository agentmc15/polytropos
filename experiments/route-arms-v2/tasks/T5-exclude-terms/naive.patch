+def _normalize_exclude_terms(exclude_terms):
+    if not exclude_terms:
+        return []
+    if isinstance(exclude_terms, str):
+        return [exclude_terms.lower()]
+    return [str(term).lower() for term in exclude_terms if str(term).strip()]
