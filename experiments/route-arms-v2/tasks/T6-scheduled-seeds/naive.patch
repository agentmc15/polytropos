+def parse_due_seeds(text, for_date):
+    target = date.fromisoformat(for_date)
+    items = []
+    for raw in text.split("\n"):
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        for marker in SEED_MARKERS:
+            if line.startswith(marker):
+                line = line[len(marker):].strip()
+                break
+        low = line.lower()
+        if low.startswith("on "):
+            try:
+                when, title = line[3:].split(":", 1)
+                if date.fromisoformat(when.strip()).isoformat() == for_date and title.strip():
+                    items.append(title.strip())
+            except ValueError:
+                pass
+            continue
+        if low.startswith("from "):
+            m = re.match(r"from\s+(\d{4}-\d{2}-\d{2})\s+every\s+(\d+)d\s*:\s*(.*)",
+                         line, re.I)
+            if m:
+                try:
+                    start = date.fromisoformat(m.group(1))
+                    n = int(m.group(2))
+                    if n and (target - start).days >= 0 and (target - start).days % n == 0:
+                        items.append(m.group(3).strip())
+                except ValueError:
+                    pass
+            continue
+        if low.startswith("every "):
+            try:
+                days, title = line[6:].split(":", 1)
+                wanted = {WEEKDAYS[d.strip().lower()] for d in days.split(",")}
+                if target.weekday() in wanted and title.strip():
+                    items.append(title.strip())
+            except (KeyError, ValueError):
+                pass
+            continue
+        items.append(line)
+    return items
+
