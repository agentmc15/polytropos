+    def _build_seed_plan(self, seed_text, for_date="2026-04-06"):
+        with tempfile.TemporaryDirectory() as td:
+            journal_dir = Path(td)
+            plan_dir = journal_dir / "plan"
+            plan_dir.mkdir(parents=True)
+            (plan_dir / "seed.md").write_text(seed_text)
+            rc, _ = _call_main(["build", "--date", "2026-04-01", "--utc",
+                                "--for", for_date, "--journal-dir", str(journal_dir)])
+            self.assertEqual(rc, 0)
+            return mod.parse_plan((plan_dir / f"{for_date}.md").read_text())
+
+    def test_scheduled_seed_on_date_is_only_due_on_exact_runbook_date(self):
+        due = self._build_seed_plan("on 2026-04-06: File report\n", "2026-04-06")
+        not_due = self._build_seed_plan("on 2026-04-07: File report\n", "2026-04-06")
+        self.assertEqual([c["title"] for c in due["cards"]], ["File report"])
+        self.assertEqual(not_due["cards"], [])
+
+    def test_scheduled_seed_interval_uses_real_day_difference(self):
+        due = self._build_seed_plan("from 2026-03-31 every 2d: Alternating\n",
+                                    "2026-04-02")
+        not_due = self._build_seed_plan("from 2026-03-31 every 2d: Alternating\n",
+                                        "2026-04-03")
+        self.assertEqual([c["title"] for c in due["cards"]], ["Alternating"])
+        self.assertEqual(not_due["cards"], [])
+
+    def test_scheduled_seed_weekday_list_is_case_insensitive(self):
+        parsed = self._build_seed_plan("EVERY mon, WED: Standup prep\n", "2026-04-06")
+        self.assertEqual([c["title"] for c in parsed["cards"]], ["Standup prep"])
+
+    def test_invalid_scheduled_seed_adds_note_and_skips_card(self):
+        parsed = self._build_seed_plan("# heading\n\n- on 2026-02-30: Broken\n",
+                                       "2026-04-06")
+        self.assertEqual(parsed["cards"], [])
+        self.assertIn("invalid seed directive in seed.md line 3: invalid date '2026-02-30'",
+                      parsed["notes"])
