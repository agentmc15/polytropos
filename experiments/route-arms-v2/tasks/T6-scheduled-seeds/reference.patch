+    re.IGNORECASE,
+)
+WEEKDAY_SEED_RE = re.compile(r"^every\s+([^:]+?)\s*:\s*(.*)$", re.IGNORECASE)
+WEEKDAY_TOKENS = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}
 MAX_PLAN_CARDS = 100
 EST_PROFILE = "M"
 TIER_TO_SLOT = {"haiku": "cheap", "sonnet": "mid", "opus": "mid"}
@@ -296,6 +303,102 @@ def parse_seeds(text):
     return items
 
 
+def _seed_note(line_no, reason):
+    return f"invalid seed directive in {SEED_FILENAME} line {line_no}: {reason}"
+
+
+def _parse_seed_date(value, line_no, notes):
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        notes.append(_seed_note(line_no, f"invalid date {value!r}"))
+        return None
+
+
+def _scheduled_seed_title(title, line_no, notes):
+    title = title.strip()
+    if not title:
+        notes.append(_seed_note(line_no, "missing title"))
+        return None
+    return title
+
+
+def parse_scheduled_seeds(text, for_date):
+    """Parse ``seed.md`` lines, returning ``(due_seed_titles, notes)``.
+
+    Ordinary lines retain ``parse_seeds`` behaviour.  Lines beginning with a scheduling
+    keyword use the date-aware grammar and either return their stripped title when due or a
+    non-fatal note when malformed.
+    """
+    target = date.fromisoformat(for_date)
+    items = []
+    notes = []
+    for line_no, raw in enumerate(text.split("\n"), 1):
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        for marker in SEED_MARKERS:
+            if line.startswith(marker):
+                line = line[len(marker):].strip()
+                break
+        low = line.lower()
+
+        if low.startswith("on "):
+            m = ON_SEED_RE.match(line)
+            if not m:
+                notes.append(_seed_note(line_no, "expected 'on YYYY-MM-DD: title'"))
+                continue
+            when = _parse_seed_date(m.group(1), line_no, notes)
+            title = _scheduled_seed_title(m.group(2), line_no, notes)
+            if when == target and title is not None:
+                items.append(title)
+            continue
+
+        if low.startswith("from "):
+            m = INTERVAL_SEED_RE.match(line)
+            if not m:
+                notes.append(_seed_note(line_no, "expected 'from YYYY-MM-DD every Nd: title'"))
+                continue
+            start = _parse_seed_date(m.group(1), line_no, notes)
+            title = _scheduled_seed_title(m.group(3), line_no, notes)
+            try:
+                interval = int(m.group(2))
+            except ValueError:
+                interval = 0
+            if not 1 <= interval <= 366:
+                notes.append(_seed_note(line_no, "interval must be 1..366 days"))
+                continue
+            if start is not None and title is not None:
+                delta = (target - start).days
+                if delta >= 0 and delta % interval == 0:
+                    items.append(title)
+            continue
+
+        if low.startswith("every "):
+            m = WEEKDAY_SEED_RE.match(line)
+            if not m:
+                notes.append(_seed_note(line_no, "expected 'every mon[,tue...]: title'"))
+                continue
+            title = _scheduled_seed_title(m.group(2), line_no, notes)
+            wanted = set()
+            bad = None
+            for token in m.group(1).split(","):
+                token = token.strip().lower()
+                if token not in WEEKDAY_TOKENS:
+                    bad = token
+                    break
+                wanted.add(WEEKDAY_TOKENS[token])
+            if bad is not None:
+                notes.append(_seed_note(line_no, f"unknown weekday {bad!r}"))
+                continue
+            if title is not None and target.weekday() in wanted:
+                items.append(title)
+            continue
+
+        items.append(line)
+    return items, notes
+
+
