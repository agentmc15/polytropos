 SEED_FILENAME = "seed.md"
 PLAN_STEM_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
 SEED_MARKERS = ("- ", "* ", "[ ] ")   # read_inbox parity (journal_collect.py)
+ON_SEED_RE = re.compile(r"^on\s+(\d{4}-\d{2}-\d{2})\s*:\s*(.*)$", re.IGNORECASE)
+INTERVAL_SEED_RE = re.compile(
