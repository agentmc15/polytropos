+def normalize_project_patterns(raw):
+    """Normalize project filter arguments into a validated, ordered list."""
+    if raw is None:
+        return []
+    values = [raw] if isinstance(raw, str) else list(raw)
+    patterns = []
+    for value in values:
+        for piece in str(value).split(","):
+            pattern = piece.strip()
+            if not pattern:
+                raise ValueError("project filter patterns must not be empty")
+            if "/" in pattern or "\\" in pattern:
+                raise ValueError("project filters match project names only, not paths")
+            patterns.append(pattern)
+    return patterns
+
+
+def project_allowed(project, include, exclude):
+    """Return whether a transcript project name passes include/exclude filters."""
+    if include and not any(fnmatch.fnmatchcase(project, pat) for pat in include):
+        return False
+    if any(fnmatch.fnmatchcase(project, pat) for pat in exclude):
+        return False
+    return True
+
