+def _normal_usage(raw):
+    clean = {}
+    for fld in ("input", "output", "cache_read", "cache_write"):
+        value = raw.get(fld, 0)
+        if value is None:
+            value = 0
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            return None
+        clean[fld] = value
+    return clean if any(clean.values()) else None
