+def _normal_usage(raw):
+    """Return a sanitized usage bucket dict, or None for malformed/zero records."""
+    clean = {}
+    for fld in ("input", "output", "cache_read", "cache_write"):
+        value = raw.get(fld, 0)
+        if value is None:
+            value = 0
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            return None
+        clean[fld] = value
+    return clean if any(clean.values()) else None
+
+
+def _model_label(model):
+    return str(model)
+
+
+def _match_model(model, pricing):
+    try:
+        return cr.match_model(model, pricing)
+    except AttributeError:
+        return None
+
+
+def count_task_outputs(task_dirs):
+    """Count unique existing task-dir *.output files for source reporting only."""
+    seen = set()
+    for d in task_dirs:
+        for f in sorted(Path(d).glob("*.output")):
+            try:
+                rp = f.resolve()
+            except OSError:
+                rp = f
+            if f.is_file():
+                seen.add(rp)
+    return len(seen)
+
