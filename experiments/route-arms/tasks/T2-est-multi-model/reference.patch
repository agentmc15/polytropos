+def parse_model_ids(raw):
+    """Split `est`'s MODEL_ID argument on commas -> list of ids, in the order given.
+
+    Raises `ValueError` for an empty segment or a repeated id.
+    """
+    ids = [part.strip() for part in raw.split(",")]
+    if any(not model_id for model_id in ids):
+        raise ValueError(f"empty model id in {raw!r}")
+    repeated = sorted({model_id for model_id in ids if ids.count(model_id) > 1})
+    if repeated:
+        raise ValueError(f"duplicate model id(s): {', '.join(repeated)}")
+    return ids
+
+
+def _est_json(args, model_id, result):
+    return {
+        "profile": args.profile,
+        "model_id": model_id,
+        "cache_hit": args.cache_hit,
+        "usd": round(result["usd"], 4),
+        "aic": round(result["aic"], 4),
+        "rates_used": result["rates_used"],
+        "warnings": result["warnings"],
+    }
+
+
+def _print_est(args, model_id, result):
+    print(f"profile {args.profile} on {model_id}, cache_hit={args.cache_hit}")
+    print(f"  usd:   ${result['usd']:.4f}")
+    print(f"  aic:   {result['aic']:.1f}")
+    print(f"  rates: {result['rates_used']}")
+    for w in result["warnings"]:
+        print(f"  warning: {w}")
+
+
