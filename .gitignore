.claude/settings.local.json
__pycache__/
.DS_Store
# daily-journal output + inbox (personal data — never committed)
/journal/
# routing-trend snapshot store (generated local data — never committed)
/trends/
# memory-skill fact store (private user data — never committed)
/memory/
# copilot model prefs — user pins/excludes (user data — never committed)
/prefs/
# telemetry snapshot store (personal cost data — never committed)
/telemetry/

# repo-bench measurement store (run artifacts, sandboxes, dollar data — never committed)
/benchruns/

# workflow-eval store (trial records, attempt ledgers, sandboxes, dollar data — never committed)
/evals/

# attempt ledger (per-run dispatch/verify records with bounded output tails — never committed;
# its default home is the per-user data root, this entry covers a legacy in-tree store only)
/attempts/

# decision-time training snapshots (bounded, redacted evidence one decision was taken on, with
# source ids and eligibility — never committed; its default home is the per-user data root, this
# entry covers a legacy in-tree store only. Collection is OFF: training_data.COLLECTION_ENABLED
# is False and nothing calls the hook, so a fresh checkout never creates this directory)
/training/

# conversation summaries (transcript-derived: home-dir paths, session ids — never committed)
/conv-summaries/

# generated value reports (personal dollar data, session ids, machine paths — never committed)
/value-report*.html

# kit_verify_hook.py verify-pass markers (timestamped proof-of-verify, kit-local, any slug —
# never committed; matches .claude/kits/<slug>/verify-pass/ for every kit, not the kit files
# beside it)
/.claude/kits/*/verify-pass/

# local Codex-harness install artifacts (written by `harness_select install --harness codex`
# at project scope — install DESTINATIONS, not source; the bundle source lives in codex/,
# whose own AGENTS.md stays tracked because these are root-anchored)
/.codex/
/AGENTS.md

# graphify knowledge-graph output (local analysis artifacts, never committed)
/graphify-out/

# mkdocs build output (docs-site kit) — built in CI, never committed
/site-build/
